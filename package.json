{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfólio de automação de testes E2E com Playwright + TypeScript, contra o ServeRest rodando 100% local.",
  "scripts": {
    "sut:setup": "bash scripts/setup-sut.sh",
    "test": "playwright test",
    "test:api": "playwright test --grep @api",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "serverest": "^3.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
